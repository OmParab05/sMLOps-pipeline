# Python bytecode cache
__pycache__/

# Virtual environment (both names used across setup)
venv/
.venv/

# PyCharm project settings
.idea/

# Jupyter autosave checkpoints
.ipynb_checkpoints/

# Raw dataset
data/*.csv

# Processed train/test splits (regenerated by preprocessing.py)
data/processed/
data/simulated/

# Trained model artifacts (regenerated by train.py)
models/*.pkl

# MLflow local tracking store
mlruns/

# DVC cache (pointer files themselves should stay tracked)
.dvc/cache/

# OS junk files
.DS_Store